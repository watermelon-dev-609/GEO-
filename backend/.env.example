# GEO优化器 API密钥配置模板（v2.0）
# 复制此文件为 .env 并填入真实密钥，.env 不会被提交到 Git
# 支持 ${VAR} 占位符在 api_keys.yaml 中引用

# ── 云平台 API Keys ──
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DOUBAO_API_KEY=your-volcengine-api-key-here
KIMI_API_KEY=sk-your-kimi-key-here
TONGYI_API_KEY=your-dashscope-api-key-here
WENXIN_API_KEY=your-baidu-api-key-here
WENXIN_SECRET_KEY=your-baidu-secret-key-here
XINGHUO_API_KEY=your-xinghuo-api-key
YUANBAO_API_KEY=your-hunyuan-api-key-here
YUANBAO_SECRET_ID=your-tencent-secret-id-here
CLAUDE_API_KEY=sk-ant-your-claude-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# ── 本地 LLM（无需 API Key，留空即可） ──
# Ollama: 默认 http://localhost:11434
# LM Studio: 默认 http://localhost:1234
